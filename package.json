{
  "name": "surgepass",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "gateway",
    "provider-mock",
    "agent",
    "waiting-room",
    "dashboard"
  ],
  "scripts": {
    "setup:hedera": "tsx scripts/setup-hedera.ts",
    "setup:keys": "tsx scripts/gen-keys.ts",
    "dev:provider": "tsx watch provider-mock/src/index.ts",
    "dev:gateway": "WAITING_ROOM_DEV=1 tsx watch gateway/src/index.ts",
    "dev:agent": "tsx watch agent/src/mcp-server.ts",
    "dev:waiting-room": "npm run dev -w waiting-room",
    "dev:dashboard": "npm run dev -w dashboard",
    "dev": "concurrently -n provA,provB,gateway,room,console,agent -c gray,gray,blue,green,magenta,cyan \"PROVIDER_PORT=4000 PROVIDER_NAME=A npm run dev:provider\" \"PROVIDER_PORT=4001 PROVIDER_NAME=B npm run dev:provider\" \"npm run dev:gateway\" \"npm run dev:waiting-room\" \"npm run dev:dashboard\" \"npm run dev:agent\"",
    "seed": "tsx scripts/seed-drops.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "reset": "tsx scripts/reset.ts",
    "test": "tsx --test packages/shared/test/*.test.ts gateway/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "flood": "tsx loadgen/flood.ts",
    "humans": "tsx loadgen/humans.ts",
    "agent": "tsx agent/src/cli.ts",
    "build": "npm run build -w waiting-room && npm run build -w dashboard",
    "partner": "tsx agent/src/partner.ts",
    "setup:accounts": "tsx scripts/create-accounts.ts",
    "demo:flood": "tsx loadgen/flood.ts --rps 1500 --duration 45"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "undici": "^8.12.4",
    "ioredis": "^6.0.0"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.90.1",
    "jose": "^6.2.15"
  }
}
