# ─── Gateway ────────────────────────────────────────────────
GATEWAY_PORT=8080
# Public origin of the gateway (the provider's domain points here)
GATEWAY_ORIGIN=http://localhost:8080
# Upstream provider behind the gateway (mock provider A)
UPSTREAM_URL=http://localhost:4000
# Mock provider B is hit directly by the demo (no gateway)
DIRECT_PROVIDER_URL=http://localhost:4001
REDIS_URL=redis://localhost:6379
# Admin token for the dashboard API
ADMIN_TOKEN=change-me
# Dashboard origin (CORS)
DASHBOARD_ORIGIN=http://localhost:5174

# Ed25519 keys for passes and X-SurgePass-Assertion (npm run setup:keys)
PASS_SIGNING_KEY=
PASS_PUBLIC_KEY=
PASS_KEY_ID=sp-1

# ─── World ID ───────────────────────────────────────────────
# From developer.world.org
WORLD_APP_ID=app_
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# production | staging
WORLD_ENVIRONMENT=staging

# ─── Hedera ────────────────────────────────────────────────
HEDERA_NETWORK=testnet
# Operator: pays for HCS topics / messages and the random-number transactions
HEDERA_OPERATOR_ID=0.0.
HEDERA_OPERATOR_KEY=
# Account that receives x402 payments
SURGEPASS_PAY_TO=0.0.
# Only needed to associate an HTS payment token with the receiving account
SURGEPASS_PAY_TO_KEY=
# x402 facilitator (official or Blocky402)
X402_FACILITATOR_URL=https://x402.org/facilitator
# Payment asset: 0.0.0 = HBAR, or an HTS token id
PAYMENT_ASSET=0.0.0
PAYMENT_ASSET_DECIMALS=8
# How many asset units equal ₹1 (used to display surge prices in INR)
ASSET_UNITS_PER_INR=1000000
# Written by `npm run setup:hedera`
HCS_TOPIC_ID=
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ─── Reference agent ────────────────────────────────────────
AGENT_ACCOUNT_ID=0.0.
AGENT_PRIVATE_KEY=
# Budget the agent may spend, in INR
AGENT_BUDGET_INR=50
AGENT_MCP_PORT=8090

# ─── Abuse limits (per IP, per minute) ──────────────────────
WORLD_CONTEXT_PER_MIN=30
WORLD_VERIFY_PER_MIN=20
